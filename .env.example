# Copy to .env next to docker-compose.yml. .env is gitignored; never commit it.
# Configuration precedence is environment -> file -> default.

# Required. MemoryGate refuses to start without it. At least 16 characters.
#   echo "MEMORYGATE_ADMIN_KEY=$(openssl rand -base64 24)" >> .env
# Once the service runs you can set a database-managed key from the dashboard's
# Settings screen; after that this variable is no longer consulted.
MEMORYGATE_ADMIN_KEY=

# Optional. Browser origins allowed to call the API. Defaults to the bundled
# dashboard's own origins. "*" is a development override only - it puts every
# route in reach of any page the owner has open.
# MEMORYGATE_CORS_ORIGINS=http://localhost:8021,http://127.0.0.1:8021

# Optional. Seeds one read-only agent key at startup. Must start with mg_read_.
# MEMORYGATE_BOOTSTRAP_READ_KEY=
# MEMORYGATE_BOOTSTRAP_AGENT_ID=agent_pi_operator

# Required for semantic retrieval. The admin key of the Embeddings sidecar,
# which serves the model over HTTP from its own repo. Without it, semantic
# search reports degraded and retrieval falls back to the lexical path, saying
# so on every response. EMBED_DIMENSION must match the sidecar's model.
EMBEDDINGS_KEY=
# EMBEDDINGS_URL=http://embeddings-api:8030
# EMBED_DIMENSION=1024

# Legacy. Kept only so an old .env does not silently change behaviour; the
# in-process provider is gone and retrieval falls back to
# lexical matching, saying so on every response. EMBED_MODEL=hash was removed:
# it returned vectors with no semantic meaning.
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBED_DIMENSION=384

# Pi conversation evidence: a dedicated ingestion/deletion capability, not admin.
# Generate a separate random key of at least 16 characters. See docs/conversation-memory.md.
# MEMORYGATE_CONVERSATION_KEY=
# MEMORYGATE_CONVERSATION_AGENT_ID=agent_pi_operator

# Optional. Pi's model roles: with both set, every model call goes to Pi's
# memory-sorting role and the model is chosen in Conker (Settings, Models,
# Memory sorting); MemoryGate's own AI runtime setting then decides nothing.
# Without them, MemoryGate calls its own runtime directly. See docs/ai-runtime.md.
# MEMORYGATE_PI_URL=http://pi:8050
# MEMORYGATE_PI_SERVICE_KEY=
